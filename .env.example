# Copy to .env for local runs. In GitHub Actions, set these as repository secrets.
# Never commit .env.

# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Gmail: the address that sends the digest, and an app password (not your login password).
# https://myaccount.google.com/apppasswords  (requires 2-step verification)
# Resend and other SMTP providers work too: set SMTP_HOST and SMTP_PORT.
SMTP_USER=
SMTP_APP_PASSWORD=
# One address, or several separated by commas. You can also list people
# under delivery.email_to in config.yaml. The two lists are combined.
EMAIL_TO=
EMAIL_FROM=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# Telegram: create a bot with @BotFather, message it, then read chat id from getUpdates.
# https://api.telegram.org/bot<token>/getUpdates
# TELEGRAM_CHAT_ID can be several ids separated by commas.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
